#* 预发布环境

# Environmental variable
VITE_APP_ENV = production

# Interface request address
VITE_API_BASE = /api

# ========== 微前端配置 ==========
# 子应用预发布环境部署路径
VITE_MICRO_APP_BASE = /cim/
# 子应用静态资源 origin
VITE_MICRO_APP_ORIGIN = https://staging.srdcloud.cn

# ========== i18n 翻译配置 ==========
# 预发布环境启用翻译（使用已生成的 lang/index.json）
VITE_I18N_ENABLED=true

# 预发布环境不需要真实 API 密钥
VITE_YOUDAO_APP_ID=dummy
VITE_YOUDAO_APP_KEY=dummy
