#* 测试环境

# Environmental variable
VITE_APP_ENV = test

# Interface request address
VITE_API_BASE = /api

# ========== 微前端配置 ==========
# 子应用测试环境部署路径
VITE_MICRO_APP_BASE = /cim/
# 子应用静态资源 origin
VITE_MICRO_APP_ORIGIN = http://192.168.28.177:30650

# ========== i18n 翻译配置 ==========
# 测试环境启用翻译（使用已生成的 lang/index.json）
VITE_I18N_ENABLED=true

# 测试环境不需要真实 API 密钥
VITE_YOUDAO_APP_ID=dummy
VITE_YOUDAO_APP_KEY=dummy
