#* 生产环境

# Environmental variable
VITE_APP_ENV = production

# Interface request address
VITE_API_BASE = /api

# ========== 微前端配置 ==========
# 子应用生产环境部署路径（Nginx 需配置 /cim/ 指向子应用 dist 目录）
VITE_MICRO_APP_BASE = /cim/
# 子应用静态资源 origin（生产环境设置为实际部署域名）
VITE_MICRO_APP_ORIGIN = https://your-production-domain
# 微前端子应用名称
VITE_MICRO_APP_NAME = cim
# Service Route ID（生产环境需配置实际值）
VITE_SERVICE_ROUTE_ID =

# ========== i18n 翻译配置 ==========
# 生产构建无需 i18n 插件（运行时由 lang/index.js 提供 $t，插件只在开发时扫描/翻译）
VITE_I18N_ENABLED=false

# 生产环境不需要真实 API 密钥（buildToDist 只需要插件启用即可）
VITE_YOUDAO_APP_ID=dummy
VITE_YOUDAO_APP_KEY=dummy
