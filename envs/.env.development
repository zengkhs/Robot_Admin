#* 开发环境

# Environmental variable
VITE_APP_ENV = development

# Interface request address
VITE_API_BASE = /api

# ========== 微前端配置 ==========
# 子应用生产环境部署路径（开发环境使用默认 / 即可）
VITE_MICRO_APP_BASE = /
# 子应用静态资源 origin（开发环境必须设置，否则基座加载子应用资源 404）
VITE_MICRO_APP_ORIGIN = http://localhost:1988
# 微前端子应用名称（与 cim-micro-lite 一致）
VITE_MICRO_APP_NAME = cim
# Service Route ID（请求头 cloudna-service-route-id，用于后端路由）
VITE_SERVICE_ROUTE_ID = zengkh

# ========== i18n 自动翻译配置 ==========
VITE_I18N_ENABLED=false

# 有道翻译 API 配置（申请地址：https://ai.youdao.com/）
VITE_YOUDAO_APP_ID=4698e6039981b2fe
VITE_YOUDAO_APP_KEY=ryLIKtQVSKgl4yQJ2Sp7wG7D5fuqoFrM
